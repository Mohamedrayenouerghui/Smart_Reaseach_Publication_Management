  <property name="styleSheet">
   <string notr="true">
QWidget#Submission { background-color: #F5F7FA; }
QTabWidget::pane {
    border: 1.5px solid #E2E8F0; border-radius: 12px;
    background-color: #FFFFFF; top: -1px; margin: 16px;
}
QTabBar::tab {
    background-color: #F8FAFC; color: #64748B;
    padding: 12px 24px; border: 1.5px solid #E2E8F0;
    border-bottom: none; border-top-left-radius: 8px;
    border-top-right-radius: 8px; font-family: 'Segoe UI', sans-serif;
    font-size: 14px; font-weight: 600; margin-right: 4px; margin-left: 16px;
}
QTabBar::tab:selected { background-color: #FFFFFF; color: #8B5CF6; border-bottom: 2px solid #8B5CF6; }
QTabBar::tab:hover:!selected { background-color: #EEF2FF; color: #8B5CF6; }
QGroupBox {
    font-weight: 700; font-size: 13px; color: #374151;
    border: 1.5px solid #E2E8F0; border-radius: 10px;
    margin-top: 12px; padding: 16px; background-color: white;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 12px; top: -6px;
    background-color: white; padding: 0 6px; color: #8B5CF6;
}
QLabel { color: #374151; font-size: 13px; font-weight: 600; }
QComboBox {
    border: 1.5px solid #E2E8F0; border-radius: 8px;
    padding: 10px 14px; background: white; color: #1E293B;
    font-size: 13px; min-height: 20px;
}
QComboBox:focus { border-color: #8B5CF6; }
QComboBox::drop-down { border: none; padding-right: 12px; }
QComboBox::down-arrow {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6B7280;
}
QTableWidget {
    background-color: white; border: none;
    gridline-color: #F1F5F9; font-family: 'Segoe UI', sans-serif; font-size: 13px;
}
QTableWidget::item { padding: 10px 12px; color: #374151; }
QTableWidget::item:selected { background-color: #EDE9FE; color: #7C3AED; }
QHeaderView::section {
    background-color: #F8FAFC; color: #6B7280;
    padding: 12px 16px; border: none; border-bottom: 2px solid #E2E8F0;
    font-weight: 700; font-size: 12px;
}
QPushButton#addBtn {
    background-color: #8B5CF6; color: white; border: none;
    border-radius: 8px; font-size: 14px; font-weight: 700;
    padding: 12px 24px; min-height: 44px;
}
QPushButton#addBtn:hover { background-color: #7C3AED; }
QPushButton#clearBtn {
    background-color: transparent; color: #64748B;
    border: 1.5px solid #CBD5E1; border-radius: 8px;
    font-size: 13px; padding: 12px 20px; min-height: 44px;
}
QPushButton#clearBtn:hover { background-color: #F1F5F9; }
QPushButton#deleteBtn {
    background-color: transparent; color: #EF4444;
    border: 1.5px solid #EF4444; border-radius: 8px;
    font-size: 13px; padding: 10px 20px;
}
QPushButton#deleteBtn:hover { background-color: #EF4444; color: white; }
QPushButton#deleteBtn:disabled { color: #CBD5E1; border-color: #CBD5E1; }
QPushButton#searchBtn {
    background-color: transparent; color: #3B82F6;
    border: 2px solid #3B82F6; border-radius: 8px;
    font-size: 13px; font-weight: 600; padding: 8px 16px;
}
QPushButton#searchBtn:hover { background-color: #3B82F6; color: white; }
QPushButton#sortBtn {
    background-color: transparent; color: #8B5CF6;
    border: 2px solid #8B5CF6; border-radius: 8px;
    font-size: 13px; font-weight: 600; padding: 8px 16px;
}
QPushButton#sortBtn:hover { background-color: #8B5CF6; color: white; }
QPushButton#statsBtn {
    background-color: transparent; color: #14B8A6;
    border: 2px solid #14B8A6; border-radius: 8px;
    font-size: 13px; font-weight: 600; padding: 8px 16px;
}
QPushButton#statsBtn:hover { background-color: #14B8A6; color: white; }
QLineEdit {
    border: 1.5px solid #E2E8F0; border-radius: 8px;
    padding: 8px 14px; background: white; color: #475569; font-size: 13px;
}
QLineEdit:focus { border-color: #8B5CF6; background: #FAFBFF; }
