             <item row="2" column="0">
              <widget class="QLabel" name="modLieuLabel">
               <property name="text"><string>Lieu :</string></property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="modLieuLineEdit">
               <property name="placeholderText"><string>Lieu de la conférence</string></property>
              </widget>
