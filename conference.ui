     <widget class="QWidget" name="modifierTab">
      <attribute name="title"><string>Modifier une Conférence</string></attribute>
      <layout class="QVBoxLayout" name="verticalLayout_modifier">
       <item>
        <widget class="QScrollArea" name="scrollAreaModifier">
         <property name="widgetResizable"><bool>true</bool></property>
         <widget class="QWidget" name="scrollAreaModifierContents">
          <property name="geometry"><rect><x>0</x><y>0</y><width>1156</width><height>650</height></rect></property>
          <layout class="QVBoxLayout" name="verticalLayout_modifierInner">
           <item>
            <layout class="QFormLayout" name="formLayoutModifier">

             <item row="0" column="0">
              <widget class="QLabel" name="modIdLabel">
               <property name="text"><string>ID Conférence :</string></property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="modIdLineEdit">
               <property name="readOnly"><bool>true</bool></property>
