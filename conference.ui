               <property name="text"><string>Date Fin :</string></property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QDateEdit" name="modDateFinEdit">
               <property name="calendarPopup"><bool>true</bool></property>
              </widget>
             </item>

             <item row="5" column="0">
              <widget class="QLabel" name="modFraisLabel">
               <property name="text"><string>Frais d'Inscription (DT) :</string></property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QDoubleSpinBox" name="modFraisSpinBox">
               <property name="maximum"><double>999999.990000000000000</double></property>
               <property name="decimals"><number>2</number></property>
              </widget>
