  <property name="styleSheet">
   <string notr="true">
QWidget#Conference {
    background-color: #F5F7FA;
}

QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: white;
    border-radius: 10px;
}

QTabBar::tab {
    background-color: #F8FAFC;
    color: #64748B;
    padding: 12px 28px;
    margin-right: 4px;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI', sans-serif;
}

QTabBar::tab:selected {
    background-color: #8B5CF6;
    color: white;
    border-color: #8B5CF6;
}

QTabBar::tab:hover:!selected {
    background-color: #EDE9FE;
    color: #8B5CF6;
}

QTableWidget {
    background-color: white;
    border: none;
    gridline-color: #F1F5F9;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

QTableWidget::item {
    padding: 10px 12px;
    color: #374151;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:selected {
    background-color: #EDE9FE;
    color: #7C3AED;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #6B7280;
    padding: 12px 16px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    font-weight: 700;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLineEdit, QTextEdit, QDateEdit, QSpinBox, QDoubleSpinBox {
    padding: 10px 14px;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    background-color: white;
    color: #1E293B;
    font-size: 14px;
    font-family: 'Segoe UI', sans-serif;
    min-height: 20px;
}

QLineEdit:focus, QTextEdit:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #8B5CF6;
    background-color: #FEFCFF;
}

QComboBox {
    padding: 10px 14px;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    background-color: white;
    color: #1E293B;
    font-size: 14px;
    font-family: 'Segoe UI', sans-serif;
    min-height: 20px;
}

QComboBox:focus {
    border: 2px solid #8B5CF6;
}

QComboBox::drop-down {
    border: none;
    padding-right: 12px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6B7280;
}

QLabel {
    color: #374151;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI', sans-serif;
}

QPushButton {
    border-radius: 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    min-height: 40px;
    cursor: pointer;
}

QPushButton#ajouterListeButton {
    color: #10B981;
    border: 2px solid #10B981;
    background-color: transparent;
}
QPushButton#ajouterListeButton:hover {
    background-color: #10B981;
    color: white;
}

QPushButton#modifierButton {
    color: #3B82F6;
    border: 2px solid #3B82F6;
    background-color: transparent;
}
QPushButton#modifierButton:hover {
    background-color: #3B82F6;
    color: white;
}

QPushButton#supprimerButton {
    color: #EF4444;
    border: 2px solid #EF4444;
    background-color: transparent;
}
QPushButton#supprimerButton:hover {
    background-color: #EF4444;
    color: white;
}

QPushButton#trierButton {
    color: #8B5CF6;
    border: 2px solid #8B5CF6;
    background-color: transparent;
}
QPushButton#trierButton:hover {
    background-color: #8B5CF6;
    color: white;
}

QPushButton#exporterPDFButton {
    color: #F59E0B;
    border: 2px solid #F59E0B;
    background-color: transparent;
}
QPushButton#exporterPDFButton:hover {
    background-color: #F59E0B;
    color: white;
}

QPushButton#rechercherButton {
    color: #3B82F6;
    border: 2px solid #3B82F6;
    background-color: transparent;
}
QPushButton#rechercherButton:hover {
    background-color: #3B82F6;
    color: white;
}

QPushButton#clearSearchButton {
    color: #64748B;
    border: 2px solid #E2E8F0;
    background-color: transparent;
}
QPushButton#clearSearchButton:hover {
    background-color: #64748B;
    color: white;
}

QPushButton#submitConferenceButton {
    background-color: #8B5CF6;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 30px;
    min-height: 50px;
}
QPushButton#submitConferenceButton:hover {
    background-color: #7C3AED;
}
QPushButton#submitConferenceButton:pressed {
    background-color: #6D28D9;
}

QPushButton#resetFormButton {
    background-color: transparent;
    color: #64748B;
    border: 1.5px solid #CBD5E1;
    border-radius: 10px;
    font-size: 14px;
    padding: 14px 24px;
    min-height: 50px;
}
QPushButton#resetFormButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}
