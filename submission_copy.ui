QWidget#Conference {
    background-color: #F5F7FA;
}

QTabWidget::pane {
    border: 1px solid #E5E7EB;
    background-color: white;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #F3F4F6;
    color: #6B7280;
    padding: 12px 24px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 14px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #8B5CF6;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #E5E7EB;
}

QTableWidget {
    background-color: white;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
}

QTableWidget::item {
    padding: 8px;
    color: #374151;
}

QTableWidget::item:selected {
    background-color: #EDE9FE;
    color: #8B5CF6;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #6B7280;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #E5E7EB;
    font-weight: 600;
    font-size: 13px;
}

QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    padding: 10px 12px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    background-color: white;
    color: #374151;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #8B5CF6;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #6B7280;
    margin-right: 5px;
}

QLabel {
    color: #374151;
    font-size: 14px;
    font-weight: 500;
}

QPushButton {
    background-color: transparent;
    border-radius: 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 20px;
    min-height: 40px;
}

QPushButton#ajouterButton {
    color: #10B981;
    border: 2px solid #10B981;
}

QPushButton#ajouterButton:hover {
    background-color: #10B981;
    color: white;
}

QPushButton#modifierButton, QPushButton#rechercherButton {
    color: #3B82F6;
    border: 2px solid #3B82F6;
}

QPushButton#modifierButton:hover, QPushButton#rechercherButton:hover {
    background-color: #3B82F6;
